    "    \"\\n\",\n",
    "    \"        if not ((num_in_list >= min_genes) and (num_background >= min_genes)):\\n\",\n",
    "    \"            current_trait_celltype_data[f\\\"raw_p_value_bin_{i}\\\"] = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",

    "    }\n",
    "   },\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Adjust p-values\\n\",\n",
    "    \"significant, adjusted_p = fdrcorrection(new_test_df[\\\"p_value_regulation\\\"], alpha=0.05)\\n\",\n",
    "    \"new_test_df[\\\"adjusted_p_regulation\\\"] = adjusted_p\\n\",\n",
    "    \"new_test_df[\\\"significant_regulation\\\"] = significant\\n\",\n",
    "    \"new_test_df.sort_values(by='adjusted_p_regulation', ascending=True, inplace=True)\\n\",\n",
    "    \"new_test_df.head()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# merge the two data frames:\\n\",\n",
    "    \"final_results_df = pd.merge(results_df, new_test_df, on=[\\\"trait\\\", \\\"cell_type\\\"], how=\\\"left\\\")\\n\",\n",
    "    \"\\n\",\n",

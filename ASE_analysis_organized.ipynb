    "     \"start_time\": \"2025-07-03T07:43:09.129382Z\"\n",
    "    }\n",
    "   },\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"from scipy.stats import mannwhitneyu\\n\",\n",
    "    \"\\n\",\n",
    "    \"feature_col = \\\"Mapped_GWAS_MeanCounts\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"results_list = []\\n\",\n",
    "    \"mannwhitney_pvals = []\\n\",\n",
    "    \"mannwhitney_tests = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for celltype in disease_celltypes:\\n\",\n",
    "    \"    ase_col = celltype + \\\"_gene_ase_type\\\"\\n\",\n",
    "    \"    assoc_mask = filtered_data_by_gene_list[feature_col].notnull()\\n\",\n",
    "    \"    not_assoc_mask = ~assoc_mask\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Only non-ClinVar, nonzero for binning\\n\",\n",
    "    \"    binning_mask = assoc_mask & (~filtered_data_by_gene_list['is_clinvar'])\\n\",\n",
    "    \"    assoc_vals = filtered_data_by_gene_list.loc[binning_mask, feature_col]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # ---- Median-based binning ----\\n\",\n",
    "    \"    if assoc_vals.empty:\\n\",\n",
    "    \"        continue  # No data\\n\",\n",
    "    \"\\n\",\n",
    "    \"    median_val = assoc_vals.median()\\n\",\n",
    "    \"    bin_codes = (assoc_vals > median_val).astype(int)  # 0 if ≤ median, 1 if > median\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Assign bins to ALL data (NaN if not in assoc_vals)\\n\",\n",
    "    \"    bin_assignments = pd.Series(np.nan, index=filtered_data_by_gene_list.index)\\n\",\n",
    "    \"    bin_assignments.loc[assoc_vals.index] = bin_codes\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Optionally: assign ClinVar genes to bin 1\\n\",\n",
    "    \"    clinvar_mask = assoc_mask & filtered_data_by_gene_list['is_clinvar']\\n\",\n",
    "    \"    bin_assignments.loc[clinvar_mask] = 1\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # ---- Fisher's OR per bin (optional, as before) ----\\n\",\n",
    "    \"    current_trait_celltype_data = {'trait': disease, 'cell_type': celltype}\\n\",\n",
    "    \"    for i in [0, 1]:\\n\",\n",
    "    \"        current_trait_celltype_data[f\\\"logoddratio_{i}\\\"] = None\\n\",\n",
    "    \"        current_trait_celltype_data[f\\\"raw_p_value_bin_{i}\\\"] = None\\n\",\n",
    "    \"        current_trait_celltype_data[f\\\"ci_low_bin_{i}\\\"] = None\\n\",\n",
    "    \"        current_trait_celltype_data[f\\\"ci_high_bin_{i}\\\"] = None\\n\",\n",
    "    \"        current_trait_celltype_data[f\\\"fdr_p_value_bin_{i}\\\"] = None\\n\",\n",
    "    \"        current_trait_celltype_data[f\\\"significance_bin_{i}\\\"] = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for i in [0, 1]:\\n\",\n",
    "    \"        in_bin_mask = (bin_assignments == i)\\n\",\n",
    "    \"        a = (in_bin_mask & (filtered_data_by_gene_list[ase_col] == \\\"ASE\\\")).sum()\\n\",\n",
    "    \"        b = (in_bin_mask & (filtered_data_by_gene_list[ase_col] == \\\"nonASE\\\")).sum()\\n\",\n",
    "    \"        c = (not_assoc_mask & (filtered_data_by_gene_list[ase_col] == \\\"ASE\\\")).sum()\\n\",\n",
    "    \"        d = (not_assoc_mask & (filtered_data_by_gene_list[ase_col] == \\\"nonASE\\\")).sum()\\n\",\n",
    "    \"        table = np.array([[a, b], [c, d]])\\n\",\n",
    "    \"        try:\\n\",\n",
    "    \"            tbl = Table2x2(table)\\n\",\n",
    "    \"            logOR = tbl.log_oddsratio\\n\",\n",
    "    \"            ci_low, ci_high = tbl.log_oddsratio_confint()\\n\",\n",
    "    \"            p = tbl.log_oddsratio_pvalue()\\n\",\n",
    "    \"        except Exception:\\n\",\n",
    "    \"            logOR, ci_low, ci_high, p = np.nan, None, None, 1.0\\n\",\n",
    "    \"        current_trait_celltype_data[f\\\"logoddratio_{i}\\\"] = logOR\\n\",\n",
    "    \"        current_trait_celltype_data[f\\\"raw_p_value_bin_{i}\\\"] = p\\n\",\n",
    "    \"        current_trait_celltype_data[f\\\"ci_low_bin_{i}\\\"] = ci_low\\n\",\n",
    "    \"        current_trait_celltype_data[f\\\"ci_high_bin_{i}\\\"] = ci_high\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # ---- Mann-Whitney test: Bin 0 vs Bin 1, ASE vs nonASE ----\\n\",\n",
    "    \"    for ase_type in [\\\"ASE\\\", \\\"nonASE\\\"]:\\n\",\n",
    "    \"        bin0 = filtered_data_by_gene_list.loc[\\n\",\n",
    "    \"            (bin_assignments == 0) & (filtered_data_by_gene_list[ase_col] == ase_type), feature_col\\n\",\n",
    "    \"        ].dropna()\\n\",\n",
    "    \"        bin1 = filtered_data_by_gene_list.loc[\\n\",\n",
    "    \"            (bin_assignments == 1) & (filtered_data_by_gene_list[ase_col] == ase_type), feature_col\\n\",\n",
    "    \"        ].dropna()\\n\",\n",
    "    \"        if len(bin0) > 0 and len(bin1) > 0:\\n\",\n",
    "    \"            stat, pval = mannwhitneyu(bin0, bin1, alternative='two-sided')\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            pval = np.nan  # not enough data\\n\",\n",
    "    \"        mannwhitney_pvals.append(pval)\\n\",\n",
    "    \"        mannwhitney_tests.append({\\n\",\n",
    "    \"            'trait': disease,\\n\",\n",
    "    \"            'cell_type': celltype,\\n\",\n",
    "    \"            'ase_type': ase_type,\\n\",\n",
    "    \"            'mannwhitney_p': pval,\\n\",\n",
    "    \"        })\\n\",\n",
    "    \"\\n\",\n",
    "    \"    results_list.append(current_trait_celltype_data)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# --- FDR correction for all tests ---\\n\",\n",
    "    \"mannwhitney_pvals_array = np.array(mannwhitney_pvals)\\n\",\n",
    "    \"valid_mask = ~np.isnan(mannwhitney_pvals_array)\\n\",\n",
    "    \"fdr_significant = np.zeros_like(mannwhitney_pvals_array, dtype=bool)\\n\",\n",
    "    \"adj_pvals = np.full_like(mannwhitney_pvals_array, np.nan, dtype=float)\\n\",\n",
    "    \"\\n\",\n",
    "    \"if valid_mask.sum() > 0:\\n\",\n",
    "    \"    sig, adj = fdrcorrection(mannwhitney_pvals_array[valid_mask], alpha=0.05)\\n\",\n",
    "    \"    fdr_significant[valid_mask] = sig\\n\",\n",
    "    \"    adj_pvals[valid_mask] = adj\\n\",\n",
    "    \"\\n\",\n",
    "    \"for i, test in enumerate(mannwhitney_tests):\\n\",\n",
    "    \"    test['mannwhitney_fdr_p'] = adj_pvals[i]\\n\",\n",
    "    \"    test['mannwhitney_fdr_significant'] = fdr_significant[i]\\n\",\n",
    "    \"\\n\",\n",
    "    \"mannwhitney_df = pd.DataFrame(mannwhitney_tests)\\n\",\n",
    "    \"print(mannwhitney_df)\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"f4f8558f634871c2\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-07-03T07:43:14.498831Z\",\n",
    "     \"start_time\": \"2025-07-03T07:43:11.855205Z\"\n",
    "    }\n",
    "   },\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"sns.set(style=\\\"whitegrid\\\", font_scale=1.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for _, row in mannwhitney_df.iterrows():\\n\",\n",
    "    \"    trait, cell, ase_type = row['trait'], row['cell_type'], row['ase_type']\\n\",\n",
    "    \"    if trait.lower() != 'schizophrenia' or cell not in valid_ct:\\n\",\n",
    "    \"        continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"    subset = filtered_data_by_gene_list[\\n\",\n",
    "    \"        filtered_data_by_gene_list[cell + \\\"_gene_ase_type\\\"] == ase_type\\n\",\n",
    "    \"    ].copy()\\n\",\n",
    "    \"    binning_mask = subset[feature_col].notnull() & (~subset['is_clinvar'])\\n\",\n",
    "    \"    assoc_vals = subset.loc[binning_mask, feature_col]\\n\",\n",

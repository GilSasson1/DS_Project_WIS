    "    \"        significant_list[original_idx] = significants[i]\\n\",\n",
    "    \"    for i in range(10):\\n\",\n",
    "    \"        current_trait_celltype_data[f\\\"fdr_p_value_bin_{i}\\\"] = full_fdr_pvals[i]\\n\",\n",
    "    \"        current_trait_celltype_data[f\\\"significance_bin_{i}\\\"] = significant_list[i]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # --- Spearman Correlation (Bin vs. Odd Ratio) ---\\n\",\n",
    "    \"    # Ensure we have at least two data points for correlation\\n\",\n",
    "    \"    if len(odd_ratios_for_spearman) >= 3:\\n\",\n",
    "    \"        try:\\n\",\n",
    "    \"            # Spearmanr returns (correlation, pvalue)\\n\",\n",
    "    \"            spearman_corr, spearman_p = spearmanr(bin_indices_for_spearman, odd_ratios_for_spearman)\\n\",\n",
    "    \"            current_trait_celltype_data['spearman_r'] = spearman_corr\\n\",\n",

    "   \"source\": [\n",
    "    \"min_genes = 10\\n\",\n",
    "    \"\\n\",\n",
    "    \"# run new test but for ase distribution in each disease in each celltype, with no else genes:\\n\",\n",
    "    \"results = {\\\"trait\\\": [], \\\"cell_type\\\": [], \\\"odds_ratio_ASE_nonASE\\\": [], \\\"p_value_ASE_nonASE\\\": [],\\n\",\n",
    "    \"           \\\"ase_disease_associated_genes_count\\\": [], \\\"nonase_disease_associated_genes_count\\\": [],\\n\",\n",
    "    \"           \\\"ase_other_genes_count\\\": [], \\\"nonase_other_genes_count\\\": []}\\n\",\n",
    "    \"for index, row in disease_info_df.iterrows():\\n\",\n",
    "    \"    disease = row[\\\"Disease_name\\\"]\\n\",\n",
    "    \"    disease_celltypes = row[\\\"Celltypes\\\"]\\n\",\n",

    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"dbbba20ed45014d9\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### Bin Function\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"c92d2bbf-1eea-4eb1-8947-b4de668d520d\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-07-03T07:34:46.306548Z\",\n",
    "     \"start_time\": \"2025-07-03T07:34:46.303457Z\"\n",
    "    }\n",
    "   },\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# function for bin creation\\n\",\n",
    "    \"\\n\",\n",
    "    \"import math\\n\",\n",
    "    \"\\n\",\n",
    "    \"def create_percentile_bins(values, abs_vals=True):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Receives a list of numerical values and returns a list of 10 tuples (min, max).\\n\",\n",
    "    \"    Each tuple represents a bin containing 10% of the sorted values.\\n\",\n",
    "    \"    The first bin contains the lowest 10% of values.\\n\",\n",
    "    \"    The numbers in the bins are not inclusive (i.e., > min and < max).\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Args:\\n\",\n",
    "    \"        values (list): A list of numerical values (e.g., LFC values).\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"        list: A list of 10 tuples (min, max), representing the percentile bins.\\n\",\n",
    "    \"              Returns an empty list if the input list is empty.\\n\",\n",
    "    \"              Returns a list of (min, max) where min and max are the same\\n\",\n",
    "    \"              if there are not enough unique values to form distinct bins.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    if not values:\\n\",\n",
    "    \"        return []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if abs_vals:\\n\",\n",
    "    \"        sorted_values = sorted([abs(val) for val in values])\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        sorted_values = sorted(values)\\n\",\n",
    "    \"    n = len(sorted_values)\\n\",\n",
    "    \"    bins = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Handle edge case for very small lists\\n\",\n",
    "    \"    if n < 10:\\n\",\n",
    "    \"        # If there are fewer than 10 values, we might have some bins\\n\",\n",
    "    \"        # with the same min/max or repeated values.\\n\",\n",
    "    \"        # We can still try to divide, but the 10% rule won't hold perfectly.\\n\",\n",
    "    \"        # For simplicity, if fewer than 10 unique values, we can\\n\",\n",
    "    \"        # just use the min and max of the entire list for all bins,\\n\",\n",
    "    \"        # or handle it more granularly based on specific requirements.\\n\",\n",
    "    \"        # For this problem, we'll aim for 10 bins even if they are identical.\\n\",\n",
    "    \"        min_val = sorted_values[0]\\n\",\n",
    "    \"        max_val = sorted_values[-1]\\n\",\n",
    "    \"        for _ in range(10):\\n\",\n",
    "    \"            bins.append((min_val, max_val))\\n\",\n",
    "    \"        return bins\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for i in range(10):\\n\",\n",
    "    \"        # Calculate the start and end index for each 10% segment\\n\",\n",
    "    \"        start_index = math.floor(n * i / 10)\\n\",\n",
    "    \"        end_index = math.floor(n * (i + 1) / 10) - 1 # Adjusted to be inclusive of the last element in the segment\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Ensure the end index doesn't go out of bounds for the last bin\\n\",\n",
    "    \"        if i == 9:\\n\",\n",
    "    \"            end_index = n - 1\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Get the values for the current segment\\n\",\n",
    "    \"        segment_values = sorted_values[start_index : end_index + 1]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if not segment_values:\\n\",\n",
    "    \"            # This should ideally not happen for n >= 10, but as a safeguard\\n\",\n",
    "    \"            bins.append((None, None))\\n\",\n",
    "    \"            continue\\n\",\n",
    "    \"\\n\",\n",
    "    \"        min_val = segment_values[0]\\n\",\n",
    "    \"        max_val = segment_values[-1]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # The requirement is that values are > min and < max.\\n\",\n",
    "    \"        # This implies that the min and max of the bin themselves are exclusive boundaries.\\n\",\n",
    "    \"        # If the segment contains only one value, min_val and max_val will be the same.\\n\",\n",
    "    \"        # If all values are the same, all bins will have the same min/max.\\n\",\n",
    "    \"\\n\",\n",
    "    \"        bins.append((min_val, max_val))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return bins\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"cc5a69de-17cf-4e5b-bd09-1b60522465bb\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-06-12T13:20:44.237101Z\",\n",
    "     \"start_time\": \"2025-06-12T13:20:44.235615Z\"\n",
    "    }\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"# Creating correlation plots for schizophrenia specifically:\\n\",\n",
    "    \"\\n\",\n",
    "    \"traget_dir = schizophrenia_correlations\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"0babe1fc-8684-4192-8877-d84f7e8b6952\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-07-03T07:34:46.344469Z\",\n",
    "     \"start_time\": \"2025-07-03T07:34:46.340721Z\"\n",
    "    }\n",
    "   },\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# function to create contingency table of disease/nondisease for each LFC bin in comparison to background nonASE genes\\n\",\n",
    "    \"\\n\",\n",
    "    \"def cont_table_disease_nondisease(df, celltype, gene_list,\\n\",\n",
    "    \"                                     threshold_min=None, threshold_max=None,\\n\",\n",
    "    \"                                     threshold_type='LFC'):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Generates a contingency table comparing ASE genes within specified LFC thresholds\\n\",\n",
    "    \"    and nonASE genes, examining their presence in a specified gene list.\\n\",\n",
    "    \"    Excludes 'else' ASE type.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Args:\\n\",\n",
    "    \"        df (pd.DataFrame): The input DataFrame containing gene names, ASE types,\\n\",\n",
    "    \"                           and expression values for human and chimp.\\n\",\n",
    "    \"        celltype (str): The cell type string used to construct the ASE column name\\n\",\n",
    "    \"                        (e.g., \\\"Neurons\\\" -> \\\"Neurons_gene_ase_type\\\").\\n\",\n",
    "    \"        gene_list (list): A list of gene names (strings) to be considered \\\"in gene list\\\".\\n\",\n",
    "    \"        threshold_min (float): Minimum LFC or absolute LFC to be considered for ASE genes.\\n\",\n",
    "    \"                               (default 0)\\n\",\n",
    "    \"        threshold_max (float): Maximum LFC or absolute LFC to be considered for ASE genes.\\n\",\n",
    "    \"                               If None, no upper limit is applied for ASE genes.\\n\",\n",
    "    \"                               (default None)\\n\",\n",
    "    \"        threshold_type (str): Specifies how thresholds are applied.\\n\",\n",
    "    \"                              'LFC': Apply thresholds directly to LFC values.\\n\",\n",
    "    \"                              'absolute': Apply thresholds to absolute LFC values.\\n\",\n",
    "    \"                                          (default 'LFC')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"        pd.DataFrame: A contingency table with 2 columns: \\\"ASE within thresholds\\\" and \\\"nonASE genes\\\",\\n\",\n",
    "    \"                      and two rows: \\\"Disease Associated Genes\\\" and \\\"Other Genes\\\".\\n\",\n",
    "    \"        num_disease_genes_in_celltype: count of disease associated genes in the analysis (ASE within thresholds or nonASE)\\n\",\n",
    "    \"        num_other_genes_in_celltype: count of background genes in the analysis (ASE within thresholds or nonASE)\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    ase_colname = celltype + \\\"_gene_ase_type\\\"\\n\",\n",
    "    \"    human_expr_col = celltype + \\\"_LFC_human_ref\\\"\\n\",\n",
    "    \"    gene_col_name = df.columns[0]  # Assuming gene names are in the first column\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Convert gene list and DataFrame gene names to lowercase for robust matching\\n\",\n",
    "    \"    lowercase_gene_list = [gene.lower() for gene in gene_list]\\n\",\n",
    "    \"    df[gene_col_name] = df[gene_col_name].str.lower()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Create a working column for LFC values, based on threshold_type\\n\",\n",
    "    \"    df['lfc_for_thresholding'] = df[human_expr_col]\\n\",\n",
    "    \"    if threshold_type == 'absolute':\\n\",\n",
    "    \"        df['lfc_for_thresholding'] = df[human_expr_col].abs()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Filter for genes that are \\\"ASE\\\" and fall within the specified LFC thresholds\\n\",\n",
    "    \"    # Also include all \\\"nonASE\\\" genes for the background\\n\",\n",
    "    \"    filtered_df = pd.DataFrame()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Process 'ASE' genes\\n\",\n",
    "    \"    ase_df = df[df[ase_colname] == 'ASE'].copy()\\n\",\n",
    "    \"    if threshold_min is not None:\\n\",\n",
    "    \"        ase_df = ase_df[ase_df['lfc_for_thresholding'] >= threshold_min]\\n\",\n",
    "    \"    if threshold_max is not None:\\n\",\n",
    "    \"        ase_df = ase_df[ase_df['lfc_for_thresholding'] <= threshold_max]\\n\",\n",
    "    \"    ase_df['category_for_table'] = 'ASE within thresholds'\\n\",\n",
    "    \"    filtered_df = pd.concat([filtered_df, ase_df])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Process 'nonASE' genes\\n\",\n",
    "    \"    non_ase_df = df[df[ase_colname] == 'nonASE'].copy()\\n\",\n",
    "    \"    non_ase_df['category_for_table'] = 'nonASE genes'\\n\",\n",
    "    \"    filtered_df = pd.concat([filtered_df, non_ase_df])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Remove temporary LFC column\\n\",\n",
    "    \"    filtered_df = filtered_df.drop(columns=['lfc_for_thresholding'])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Determine if gene is in the gene list (disease associated or other)\\n\",\n",
    "    \"    filtered_df['gene_list_status'] = filtered_df[gene_col_name].apply(\\n\",\n",
    "    \"        lambda x: \\\"Disease Associated Genes\\\" if x in lowercase_gene_list else \\\"Other Genes\\\"\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Create the contingency table\\n\",\n",
    "    \"    contingency_table = pd.crosstab(\\n\",\n",
    "    \"        filtered_df['gene_list_status'],\\n\",\n",
    "    \"        filtered_df['category_for_table'],\\n\",\n",
    "    \"        dropna=False # Keep categories with zero counts for consistency\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Ensure all required columns are present, filling missing with 0\\n\",\n",
    "    \"    required_columns = [\\\"ASE within thresholds\\\", \\\"nonASE genes\\\"]\\n\",\n",
    "    \"    for col in required_columns:\\n\",\n",
    "    \"        if col not in contingency_table.columns:\\n\",\n",
    "    \"            contingency_table[col] = 0\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Ensure the order of columns and rows\\n\",\n",
    "    \"    contingency_table = contingency_table[required_columns]\\n\",\n",
    "    \"    contingency_table = contingency_table.reindex([\\\"Disease Associated Genes\\\", \\\"Other Genes\\\"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    num_disease_genes_in_celltype = contingency_table.loc[\\\"Disease Associated Genes\\\"].sum()\\n\",\n",
    "    \"    num_other_genes_in_celltype = contingency_table.loc[\\\"Other Genes\\\"].sum()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return contingency_table, num_disease_genes_in_celltype, num_other_genes_in_celltype\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"2d2c8138-a2fa-4d33-8e07-886ba22176da\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-07-03T07:34:46.394062Z\",\n",
    "     \"start_time\": \"2025-07-03T07:34:46.387419Z\"\n",
    "    }\n",
    "   },\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# function to run fisher on the new table\\n\",\n",
    "    \"from statsmodels.stats.contingency_tables import Table2x2\\n\",\n",
    "    \"\\n\",\n",
    "    \"def fisher_disease_nonsidease(contingency_table):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Performs a Fisher's exact test comparing \\\"ASE within thresholds\\\" vs. \\\"nonASE genes\\\"\\n\",\n",
    "    \"    for \\\"Disease Associated Genes\\\" vs. \\\"Other Genes\\\".\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Args:\\n\",\n",
    "    \"        contingency_table (pd.DataFrame): A DataFrame with 'Disease Associated Genes' and\\n\",\n",
    "    \"                                          'Other Genes' as rows, and\\n\",\n",
    "    \"                                          'ASE within thresholds', 'nonASE genes'\\n\",\n",
    "    \"                                          as columns.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"        tuple: (logoddsratio, pvalue, ci_low, ci_high) for the comparison.\\n\",\n",
    "    \"               Returns (np.nan, np.nan, np.nan, np.nan) if the contingency table is not\\n\",\n",
    "    \"               in the expected format or if Fisher's exact test cannot be performed.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Updated expected column names\\n\",\n",
    "    \"    expected_columns = [\\\"ASE within thresholds\\\", \\\"nonASE genes\\\"]\\n\",\n",
    "    \"    expected_index   = [\\\"Disease Associated Genes\\\", \\\"Other Genes\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if (not isinstance(contingency_table, pd.DataFrame)\\n\",\n",
    "    \"        or contingency_table.shape != (2, 2)\\n\",\n",
    "    \"        or list(contingency_table.index) != expected_index\\n\",\n",
    "    \"        or list(contingency_table.columns) != expected_columns):\\n\",\n",
    "    \"        print(\\\"Error: Contingency table not in expected format.\\\")\\n\",\n",
    "    \"        print(f\\\"Expected index: {expected_index}, Got: {list(contingency_table.index)}\\\")\\n\",\n",
    "    \"        print(f\\\"Expected columns: {expected_columns}, Got: {list(contingency_table.columns)}\\\")\\n\",\n",
    "    \"        print(f\\\"Expected shape: (2,2), Got: {contingency_table.shape}\\\")\\n\",\n",
    "    \"        return np.nan, np.nan, np.nan, np.nan\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # A: Disease Associated Genes, ASE within thresholds\\n\",\n",
    "    \"    A = int(contingency_table.loc[\\\"Disease Associated Genes\\\", \\\"ASE within thresholds\\\"])\\n\",\n",
    "    \"    # C: Disease Associated Genes, nonASE genes\\n\",\n",
    "    \"    C = int(contingency_table.loc[\\\"Disease Associated Genes\\\", \\\"nonASE genes\\\"])\\n\",\n",
    "    \"    # B: Other Genes, ASE within thresholds\\n\",\n",
    "    \"    B = int(contingency_table.loc[\\\"Other Genes\\\",            \\\"ASE within thresholds\\\"])\\n\",\n",
    "    \"    # D: Other Genes, nonASE genes\\n\",\n",
    "    \"    D = int(contingency_table.loc[\\\"Other Genes\\\",            \\\"nonASE genes\\\"])\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Check for any zero margins, as Fisher's exact test requires non-zero margins for CI calculation\\n\",\n",
    "    \"    # (A+C) is total Disease Associated Genes\\n\",\n",
    "    \"    # (B+D) is total Other Genes\\n\",\n",
    "    \"    # (A+B) is total ASE within thresholds\\n\",\n",
    "    \"    # (C+D) is total nonASE genes\\n\",\n",
    "    \"    if (A + C) == 0 or (B + D) == 0 or (A + B) == 0 or (C + D) == 0:\\n\",\n",
    "    \"        return np.nan, np.nan, np.nan, np.nan\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # statsmodels Table2x2 will compute both OR, p-value, and the 95% CI\\n\",\n",
    "    \"    # The table is arranged as:\\n\",\n",
    "    \"    # [[A, C],\\n\",\n",
    "    \"    #  [B, D]]\\n\",\n",
    "    \"    # Where A is the count of (outcome1 AND exposure1) -> Disease & ASE\\n\",\n",
    "    \"    # C is the count of (outcome1 AND exposure2) -> Disease & nonASE\\n\",\n",
    "    \"    # B is the count of (outcome2 AND exposure1) -> Other & ASE\\n\",\n",
    "    \"    # D is the count of (outcome2 AND exposure2) -> Other & nonASE\\n\",\n",
    "    \"    tbl = Table2x2([[A, C], [B, D]])\\n\",\n",
    "    \"    or_est = tbl.log_oddsratio\\n\",\n",

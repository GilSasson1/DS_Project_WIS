    "   \"source\": [\n",
    "    \"target_dir = 'ase_genes_pie_charts'\\n\",\n",
    "    \"os.makedirs(target_dir, exist_ok=True)\\n\",\n",
    "    \"for idx, col in enumerate(ASE_type_columns):\\n\",\n",
    "    \"    value_counts = data[col].value_counts()\\n\",\n",
    "    \"    # Create the pie chart\\n\",\n",
    "    \"    plt.figure(figsize=(8, 8))  # Create a new figure for each column, adjust size as needed\\n\",\n",
    "    \"    plt.pie(value_counts, labels=value_counts.index, autopct='%1.1f%%', startangle=90)\\n\",\n",
    "    \"    plt.title(f\\\"Pie Chart of {col}\\\")  # Set the title\\n\",\n",
    "    \"    plt.axis('equal')  # Ensure the pie chart is circular\\n\",\n",
    "    \"    plt.savefig(f\\\"{target_dir}/{col}.png\\\")  # Save the figure\\n\",\n",
    "    \"    if idx < 3:\\n\",\n",
    "    \"        plt.show()\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        plt.close()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"a6f1f512-e5bc-4a8c-8fec-f78389dc8ca7\",\n",
    "   \"metadata\": {\n",
    "    \"id\": \"a6f1f512-e5bc-4a8c-8fec-f78389dc8ca7\"\n",
    "   },\n",
    "   \"source\": [\n",
    "    \"## Goal of this next part: for each disease, create plots to describe distribution of gene ase type in the associated genes in comparison to the entire genome. In addition, run Fisher exact test to see if the distributions differ significantly between the associated genes and the entire genome, and do this per cell type (in all cell types relevant for each of the diseases).\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 7,\n",
    "   \"id\": \"81269f83-dc0d-4bf9-ad4f-a2d1383f4b00\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-07-03T07:34:19.642565Z\",\n",
    "     \"start_time\": \"2025-07-03T07:34:19.630823Z\"\n",
    "    },\n",
    "    \"id\": \"81269f83-dc0d-4bf9-ad4f-a2d1383f4b00\"\n",
    "   },\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# define functions\\n\",\n",
    "    \"from scipy.stats import fisher_exact\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"\\n\",\n",
    "    \"def contingency_table(df, celltype, gene_list):\\n\",\n",
    "    \"    ase_colname = celltype + \\\"_gene_ase_type\\\"\\n\",\n",
    "    \"    gene_col_name = df.columns[0]  # Assuming gene names are in the first column\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Convert gene list and DataFrame gene names to lowercase\\n\",\n",
    "    \"    lowercase_gene_list = [gene.lower() for gene in gene_list]\\n\",\n",
    "    \"    df[gene_col_name] = df[gene_col_name].str.lower()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    genes_in_list_df = df[df[gene_col_name].isin(lowercase_gene_list)][ase_colname].value_counts()\\n\",\n",
    "    \"    genes_not_in_list_df = df[~df[gene_col_name].isin(lowercase_gene_list)][ase_colname].value_counts()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Ensure all categories are present for both groups\\n\",\n",
    "    \"    all_categories = [\\\"ASE\\\", \\\"nonASE\\\", \\\"else\\\"]\\n\",\n",
    "    \"    genes_in_list_counts = genes_in_list_df.reindex(all_categories, fill_value=0)\\n\",\n",
    "    \"    genes_not_in_list_counts = genes_not_in_list_df.reindex(all_categories, fill_value=0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    contingency_table = pd.DataFrame({\\n\",\n",
    "    \"        \\\"In Gene List\\\": genes_in_list_counts,\\n\",\n",
    "    \"        \\\"Not in Gene List\\\": genes_not_in_list_counts\\n\",\n",
    "    \"    })\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return contingency_table\\n\",\n",
    "    \"\\n\",\n",
    "    \"def run_fisher_exact_test(contingency_table):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Performs Fisher's exact test on a contingency table (2x3).\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Args:\\n\",\n",
    "    \"        contingency_table (pd.DataFrame): A DataFrame with ASE categories as rows\\n\",\n",
    "    \"                                          and 'In Gene List', 'Not in Gene List' as columns.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"        tuple: A tuple containing the odds ratio and the p-value from the test.\\n\",\n",
    "    \"               Returns None if the contingency table is not in the expected format.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    if contingency_table.shape != (3, 2) or list(contingency_table.index) != [\\\"ASE\\\", \\\"nonASE\\\", \\\"else\\\"] or list(contingency_table.columns) != [\\\"In Gene List\\\", \\\"Not in Gene List\\\"]:\\n\",\n",
    "    \"        print(\\\"Warning: Contingency table is not in the expected 3x2 format with correct row and column names.\\\")\\n\",\n",
    "    \"        return None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # We need to perform Fisher's exact test for each ASE category against the others\\n\",\n",
    "    \"    results = {}\\n\",\n",
    "    \"    categories = contingency_table.index\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for i in range(len(categories)):\\n\",\n",
    "    \"        category = categories[i]\\n\",\n",
    "    \"        other_categories_count_in = contingency_table.loc[categories.difference([category]), \\\"In Gene List\\\"].sum()\\n\",\n",
    "    \"        other_categories_count_out = contingency_table.loc[categories.difference([category]), \\\"Not in Gene List\\\"].sum()\\n\",\n",
    "    \"\\n\",\n",
    "    \"        table = [\\n\",\n",
    "    \"            [contingency_table.loc[category, \\\"In Gene List\\\"], contingency_table.loc[category, \\\"Not in Gene List\\\"]],\\n\",\n",
    "    \"            [other_categories_count_in, other_categories_count_out]\\n\",\n",
    "    \"        ]\\n\",\n",
    "    \"        oddsratio, pvalue = fisher_exact(table, alternative='two-sided')\\n\",\n",
    "    \"        results[f\\\"({category} vs Others)\\\"] = {\\\"oddsratio\\\": oddsratio, \\\"pvalue\\\": pvalue}\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return results\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_ase_distribution_frequencies(contingency_table, title=\\\"ASE Frequency Distribution\\\"):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Generates a bar plot showing the frequency distribution of ASE types\\n\",\n",
    "    \"    for genes in and not in the gene list, stacked by gene list within each ASE category.\\n\",\n",
    "    \"    Prints total number of genes above each bar.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Args:\\n\",\n",
    "    \"        contingency_table (pd.DataFrame): A DataFrame with ASE categories as rows\\n\",\n",
    "    \"                                          and 'In Gene List', 'Not in Gene List' as columns.\\n\",\n",
    "    \"        title (str, optional): The title of the plot. Defaults to \\\"ASE Frequency Distribution\\\".\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    if contingency_table.shape != (3, 2) or list(contingency_table.index) != [\\\"ASE\\\", \\\"nonASE\\\", \\\"else\\\"] or list(contingency_table.columns) != [\\\"In Gene List\\\", \\\"Not in Gene List\\\"]:\\n\",\n",
    "    \"        print(\\\"Warning: Contingency table is not in the expected 3x2 format with correct row and column names for plotting frequencies.\\\")\\n\",\n",
    "    \"        return\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Calculate the total number of genes in each group\\n\",\n",
    "    \"    total_in_list = contingency_table[\\\"In Gene List\\\"].sum()\\n\",\n",
    "    \"    total_not_in_list = contingency_table[\\\"Not in Gene List\\\"].sum()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Calculate the frequencies\\n\",\n",
    "    \"    freq_table = pd.DataFrame({\\n\",\n",
    "    \"        \\\"Disease Associated Genes\\\": contingency_table[\\\"In Gene List\\\"] / total_in_list if total_in_list > 0 else 0,\\n\",\n",
    "    \"        \\\"Other Genes\\\": contingency_table[\\\"Not in Gene List\\\"] / total_not_in_list if total_not_in_list > 0 else 0\\n\",\n",
    "    \"    })\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Transpose the table for the desired stacking\\n\",\n",
    "    \"    freq_table_transposed = freq_table.T\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Plotting\\n\",\n",
    "    \"    ax = freq_table_transposed.plot(kind='bar', stacked=True, figsize=(8, 6)) # Assign plot to an axes object\\n\",\n",
    "    \"    plt.title(title)\\n\",\n",
    "    \"    plt.ylabel(\\\"Frequency (Proportion)\\\")\\n\",\n",
    "    \"    plt.xlabel(\\\"Gene Group\\\")\\n\",\n",
    "    \"    plt.xticks(rotation=0)\\n\",\n",
    "    \"    plt.legend(title=\\\"ASE Type\\\", bbox_to_anchor=(1.05, 1), loc='upper left') # Adjust legend position\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Add total counts above each bar\\n\",\n",
    "    \"    totals = [total_in_list, total_not_in_list]\\n\",\n",
    "    \"    for i, total in enumerate(totals):\\n\",\n",
    "    \"        ax.text(i, 1.02, f'n={total}', ha='center', va='bottom', fontsize=10, color='black') # 1.02 is slightly above the top of the bar\\n\",\n",
    "    \"\\n\",\n",
    "    \"    target_dir = 'barplots_with_else'\\n\",\n",
    "    \"    os.makedirs(target_dir, exist_ok=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.savefig(f\\\"{target_dir}/{title}.png\\\")\\n\",\n",
    "    \"    plt.close()\\n\",\n",
    "    \"\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 8,\n",
    "   \"id\": \"810545ec-98fe-453f-b908-1bd7bcb22ce3\",\n",

    "    \"\\n\",\n",
    "    \"    # Initialize lists to hold bin-specific odd_ratios for Spearman correlation\\n\",\n",
    "    \"    odd_ratios_for_spearman = []\\n\",\n",
    "    \"    bin_indices_for_spearman = [] # Will be 0, 1, 2, ..., 9\\n\",\n",
    "    \"\\n\",\n",
    "    \"    for i, bin_values in enumerate(bins):\\n\",\n",
    "    \"        current_trait_celltype_data[f\\\"bin_min_{i}\\\"] = bin_values[0]\\n\",\n",
    "    \"        current_trait_celltype_data[f\\\"bin_max_{i}\\\"] = bin_values[1]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        cont_table, num_in_list, num_background = cont_table_disease_nondisease(filtered_data_by_gene_list, celltype, genes, bin_values[0], bin_values[1])\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Check for valid contingency table before running Fisher's test\\n\",\n",
    "    \"        # if (num_in_list >= min_genes) and (num_background >= min_genes):\\n\",\n",
    "    \"        fisher_test = fisher_disease_nonsidease(cont_table)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        current_trait_celltype_data[f\\\"logoddratio_{i}\\\"]      = fisher_test[0]\\n\",\n",
    "    \"        current_trait_celltype_data[f\\\"raw_p_value_bin_{i}\\\"]  = fisher_test[1]\\n\",\n",
    "    \"        current_trait_celltype_data[f\\\"ci_low_bin_{i}\\\"]    = fisher_test[2]\\n\",\n",
    "    \"        current_trait_celltype_data[f\\\"ci_high_bin_{i}\\\"]   = fisher_test[3]\\n\",\n",
    "    \"\\n\",\n",
    "    \"        # Collect odd ratios for Spearman correlation, only if valid\\n\",\n",
    "    \"        if not np.isnan(fisher_test[0]): # Ensure odds ratio is not NaN\\n\",\n",
    "    \"             odd_ratios_for_spearman.append(fisher_test[0])\\n\",\n",

    "    \"        current_trait_celltype_data['spearman_p_value'] = None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    results_list.append(current_trait_celltype_data)\\n\",\n",
    "    \"\\n\",\n",
    "    \"bins_results_df = pd.DataFrame.from_dict(results_list)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# FDR correlation for spearman p values:\\n\",\n",
    "    \"# Initialize new columns\\n\",\n",
    "    \"bins_results_df['global_spearman_fdr_p_value'] = None\\n\",\n",
    "    \"bins_results_df['global_spearman_significant'] = False # Default to False\\n\",\n",
    "    \"\\n\",\n",
    "    \"spearman_values = bins_results_df[\\\"spearman_p_value\\\"].tolist()\\n\",\n",
    "    \"valid_spearmans = []\\n\",\n",
    "    \"original_indices = []\\n\",\n",
    "    \"for i, val in enumerate(spearman_values):\\n\",\n",
    "    \"    if val or val == 0: # check for None cases. keep cases where p=0\\n\",\n",
    "    \"        if not np.isnan(val): # check for nan cases\\n\",\n",

    "    \"\\n\",\n",
    "    \"    # store all data for same celltype in a list\\n\",\n",
    "    \"    current_trait_celltype_data = {'trait': disease, 'cell_type': celltype}\\n\",\n",
    "    \"\\n\",\n",

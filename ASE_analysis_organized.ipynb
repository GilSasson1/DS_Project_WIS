    "    \"clinvar = pd.read_csv(CLINVAR_PATH, sep=\\\"\\\\t\\\", low_memory=False)\\n\",\n",
    "    \"\\n\",\n",
    "    \"clinvar[\\\"gene_name\\\"] = clinvar[\\\"gene_name\\\"].astype(str)\\n\",\n",
    "    \"gene_names_clinvar = list(clinvar[\\\"gene_name\\\"].unique())\\n\",\n",
    "    \"\\n\",\n",
    "    \"# get list of genes from gwas:\\n\",\n",
    "    \"gwas = pd.read_excel(GWAS_PATH, sheet_name = \\\"Sheet1\\\")\\n\",\n",
    "    \"genes_str = \\\"\\\"\\n\",\n",
    "    \"for i in range(len(gwas)):\\n\",\n",
    "    \"    genes_str += gwas.iloc[i, 2] + \\\",\\\" # mapped gene\\n\",\n",
    "    \"    genes_str += gwas.iloc[i, 3] + \\\",\\\" # reported gene\\n\",\n",
    "    \"genes_str = genes_str.replace(\\\" \\\", \\\",\\\")\\n\",\n",
    "    \"gene_list = genes_str.split(\\\",\\\")\\n\",\n",
    "    \"for gene in gene_list:\\n\",\n",
    "    \"    gene = gene.strip()\\n\",\n",
    "    \"gene_list = list(set(gene_list))\\n\",\n",
    "    \"\\n\",\n",
    "    \"combo_gene_list = gene_names_clinvar + gene_list\\n\",\n",
    "    \"\\n\",\n",
    "    \"combo_gene_list = list(set(combo_gene_list))\\n\",\n",
    "    \"print(len(combo_gene_list))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# filter ASE data to keep only genes that are associated to something in gwas or in clinvar\\n\",\n",
    "    \"lowercase_combo_gene_list = [gene.lower() for gene in combo_gene_list]\\n\",\n",
    "    \"\\n\",\n",
    "    \"temp_filtered_data = filtered_data.copy()\\n\",\n",
    "    \"temp_filtered_data[\\\"Gene\\\"] = temp_filtered_data[\\\"Gene\\\"].str.lower()\\n\",\n",
    "    \"\\n\",\n",
    "    \"filtered_data_by_gene_list = filtered_data[\\n\",\n",
    "    \"    temp_filtered_data[\\\"Gene\\\"].isin(lowercase_combo_gene_list)\\n\",\n",
    "    \"].copy() \\n\",\n",
    "    \"\\n\",\n",
    "    \"print(filtered_data_by_gene_list.shape)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 14,\n",
    "   \"id\": \"eb29d566-f2ee-4a3b-aaa7-d1e8969d219f\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-07-03T07:34:37.693205Z\",\n",
    "     \"start_time\": \"2025-07-03T07:34:37.689733Z\"\n",
    "    }\n",
    "   },\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# define functions a bit differently to fit the new data - excluding else genes\\n\",\n",
    "    \"def contingency_table_no_else(df, celltype, gene_list):\\n\",\n",
    "    \"    ase_colname = celltype + \\\"_gene_ase_type\\\"\\n\",\n",
    "    \"    gene_col_name = df.columns[0]  # Assuming gene names are in the first column\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Convert gene list and DataFrame gene names to lowercase\\n\",\n",
    "    \"    lowercase_gene_list = [gene.lower() for gene in gene_list]\\n\",\n",
    "    \"    df[gene_col_name] = df[gene_col_name].str.lower()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    genes_in_list_df = df[df[gene_col_name].isin(lowercase_gene_list)][ase_colname].value_counts()\\n\",\n",
    "    \"    genes_not_in_list_df = df[~df[gene_col_name].isin(lowercase_gene_list)][ase_colname].value_counts()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Ensure all categories are present for both groups\\n\",\n",
    "    \"    all_categories = [\\\"ASE\\\", \\\"nonASE\\\"]\\n\",\n",
    "    \"    genes_in_list_counts = genes_in_list_df.reindex(all_categories, fill_value=0)\\n\",\n",
    "    \"    genes_not_in_list_counts = genes_not_in_list_df.reindex(all_categories, fill_value=0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    contingency_table = pd.DataFrame({\\n\",\n",
    "    \"        \\\"Disease Associated Genes\\\": genes_in_list_counts,\\n\",\n",
    "    \"        \\\"Other Genes\\\": genes_not_in_list_counts\\n\",\n",
    "    \"    })\\n\",\n",
    "    \"\\n\",\n",
    "    \"    n_associated = sum(genes_in_list_counts)\\n\",\n",
    "    \"    n_other = sum(genes_not_in_list_counts)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return contingency_table, n_associated, n_other\\n\",\n",
    "    \"\\n\",\n",
    "    \"def run_fisher_exact_test_no_else(contingency_table):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Performs Fisher's exact test on a contingency table (2x3).\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Args:\\n\",\n",
    "    \"        contingency_table (pd.DataFrame): A DataFrame with ASE categories as rows\\n\",\n",
    "    \"                                          and 'In Gene List', 'Not in Gene List' as columns.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"        tuple: A tuple containing the odds ratio and the p-value from the test.\\n\",\n",
    "    \"               Returns None if the contingency table is not in the expected format.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    expected_rows = [\\\"ASE\\\", \\\"nonASE\\\"]\\n\",\n",
    "    \"    expected_cols = [\\\"Disease Associated Genes\\\", \\\"Other Genes\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if contingency_table.shape != (2, 2) or \\\\\\n\",\n",
    "    \"       list(contingency_table.index) != expected_rows or \\\\\\n\",\n",
    "    \"       list(contingency_table.columns) != expected_cols:\\n\",\n",
    "    \"        print(\\\"Warning: Contingency table is not in the expected 2x2 format with correct row and column names (ASE, nonASE).\\\")\\n\",\n",
    "    \"        return None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # For a 2x2 table, Fisher's exact test is typically run directly\\n\",\n",
    "    \"    # on the entire table to compare the two categories.\\n\",\n",
    "    \"    # The table directly represents the counts for \\\"ASE\\\" vs \\\"nonASE\\\"\\n\",\n",
    "    \"    # in the gene list vs not in the gene list.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    table = contingency_table.values # Convert DataFrame to a NumPy array for fisher_exact\\n\",\n",
    "    \"\\n\",\n",
    "    \"    oddsratio, pvalue = fisher_exact(table,alternative='two-sided')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return oddsratio, pvalue\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 15,\n",
    "   \"id\": \"d1d9d769-0ff9-4331-8e23-f11aeb513548\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-07-03T07:34:37.726045Z\",\n",
    "     \"start_time\": \"2025-07-03T07:34:37.722440Z\"\n",
    "    }\n",
    "   },\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def plot_ase_distribution_frequencies_filtered(contingency_table, title=\\\"ASE Frequency Distribution\\\", result=None):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Generates a bar plot showing the frequency distribution of ASE types\\n\",\n",
    "    \"    for genes in and not in the gene list, stacked by ASE category.\\n\",\n",
    "    \"    Prints total number of genes above each bar.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Args:\\n\",\n",
    "    \"        contingency_table (pd.DataFrame): A DataFrame with \\\"ASE\\\", \\\"nonASE\\\" as rows\\n\",\n",
    "    \"                                          and \\\"In Gene List\\\", \\\"Not in Gene List\\\" as columns.\\n\",\n",
    "    \"        title (str, optional): The title of the plot. Defaults to \\\"ASE Frequency Distribution\\\".\\n\",\n",
    "    \"        result (tuple): A tuple containing the odds ratio and the p-value from the test.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    expected_rows = [\\\"ASE\\\", \\\"nonASE\\\"]\\n\",\n",
    "    \"    expected_cols = [\\\"Disease Associated Genes\\\", \\\"Other Genes\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Validate the contingency table format\\n\",\n",
    "    \"    if contingency_table.shape != (2, 2) or \\\\\\n\",\n",
    "    \"       list(contingency_table.index) != expected_rows or \\\\\\n\",\n",
    "    \"       list(contingency_table.columns) != expected_cols:\\n\",\n",
    "    \"        print(\\\"Warning: Contingency table is not in the expected 2x2 format with correct row and column names (ASE, nonASE) for plotting frequencies.\\\")\\n\",\n",
    "    \"        return\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Calculate the total number of genes in each group\\n\",\n",
    "    \"    total_in_list = contingency_table[\\\"Disease Associated Genes\\\"].sum()\\n\",\n",
    "    \"    total_not_in_list = contingency_table[\\\"Other Genes\\\"].sum()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Calculate the frequencies for \\\"ASE\\\" and \\\"nonASE\\\"\\n\",\n",
    "    \"    # Ensure to handle cases where total_in_list or total_not_in_list might be zero to prevent division by zero\\n\",\n",
    "    \"    freq_table = pd.DataFrame({\\n\",\n",
    "    \"        \\\"Disease Associated Genes\\\": contingency_table[\\\"Disease Associated Genes\\\"] / total_in_list if total_in_list > 0 else 0,\\n\",\n",
    "    \"        \\\"Other Genes\\\": contingency_table[\\\"Other Genes\\\"] / total_not_in_list if total_not_in_list > 0 else 0\\n\",\n",
    "    \"    })\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Transpose the table for the desired stacking (gene groups on x-axis, ASE types stacked)\\n\",\n",
    "    \"    freq_table_transposed = freq_table.T\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Define the custom colors (these are mapped by the order of columns in freq_table_transposed)\\n\",\n",
    "    \"    plot_colors = ['blue', 'lightgray'] # Corresponds to 'ASE' then 'nonASE' if original order is maintained\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Define the desired legend labels mapping from current to new\\n\",\n",
    "    \"    legend_label_map = {\\n\",\n",
    "    \"        \\\"ASE\\\": \\\"Differentially\\\\nexpressed\\\",\\n\",\n",
    "    \"        \\\"nonASE\\\": \\\"Unchanged\\\",\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Plotting\\n\",\n",
    "    \"    ax = freq_table_transposed.plot(kind='bar', stacked=True, figsize=(8, 6),\\n\",\n",
    "    \"                                    color=plot_colors) # Assigning colors for visual clarity\\n\",\n",
    "    \"    plt.title(title)\\n\",\n",
    "    \"    plt.ylabel(\\\"Frequency\\\")\\n\",\n",
    "    \"    plt.xlabel(\\\"Gene Group\\\")\\n\",\n",
    "    \"    plt.xticks(rotation=0) # Keep labels horizontal\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # --- MODIFIED LEGEND ---\\n\",\n",
    "    \"    # Get current handles and labels from the plot\\n\",\n",
    "    \"    handles, current_labels = ax.get_legend_handles_labels()\\n\",\n",
    "    \"    # Map current labels to the desired new labels\\n\",\n",
    "    \"    new_labels = [legend_label_map[label] for label in current_labels]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Set the legend with the new title and labels\\n\",\n",
    "    \"    plt.legend(handles, new_labels, title=\\\"Expression change\\\", bbox_to_anchor=(1.05, 1), loc='upper left')\\n\",\n",
    "    \"    # --- END MODIFIED LEGEND ---\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if result and len(result) > 1: # Ensure result is not None and has a p-value\\n\",\n",
    "    \"        p_val_display = result[1] # Assuming result[1] is the FDR-adjusted p-value\\n\",\n",
    "    \"    \\n\",\n",
    "    \"        # Format p-value: if < 0.001, display as '< 0.001', otherwise format to 3 decimal places\\n\",\n",
    "    \"        if p_val_display < 0.001:\\n\",\n",
    "    \"            p_value_text = \\\"FDR p < 0.001\\\"\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            p_value_text = f\\\"FDR p = {p_val_display:.3f}\\\"\\n\",\n",
    "    \"    \\n\",\n",
    "    \"        plt.text(\\n\",\n",
    "    \"            0.5, 0.02,\\n\",\n",
    "    \"            p_value_text, # Use the conditionally formatted text\\n\",\n",
    "    \"            fontsize=11,\\n\",\n",
    "    \"            ha='center',\\n\",\n",
    "    \"            va='bottom',\\n\",\n",
    "    \"            transform=plt.gca().transAxes\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.tight_layout() # Adjust plot to prevent labels from overlapping\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Add total counts above each bar\\n\",\n",
    "    \"    totals = [total_in_list, total_not_in_list]\\n\",\n",
    "    \"    for i, total in enumerate(totals):\\n\",\n",
    "    \"        # Place text slightly above the top of the stacked bar (which sums to 1.0 for frequencies)\\n\",\n",
    "    \"        ax.text(i, 1.02, f'n={int(total)}', ha='center', va='bottom', fontsize=10, color='black')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Ensure the output directory exists\\n\",\n",
    "    \"    output_dir = \\\"barplots_post_filtration_no_else\\\"\\n\",\n",
    "    \"    if not os.path.exists(output_dir):\\n\",\n",
    "    \"        os.makedirs(output_dir)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Sanitize the title for use in a filename (replace spaces with underscores, remove special characters)\\n\",\n",
    "    \"    sanitized_title = title.replace(' ', '_').replace('/', '_').replace('\\\\\\\\', '_').replace(':', '_').replace('\\\\n', '_').replace('.', '')\\n\",\n",
    "    \"    plt.savefig(f\\\"{output_dir}/{sanitized_title}.png\\\")\\n\",\n",
    "    \"    plt.show() # Keep plt.show() for direct display if running as script\\n\",\n",
    "    \"    plt.close() # Close the plot to free memory if generating many plots\"\n",
    "   ]\n",

    "    \"        sig0 = next(d['significance_bin_0'] for d in results_list if d['trait'] == trait and d['cell_type'] == cell)\\n\",\n",
    "    \"        sig1 = next(d['significance_bin_1'] for d in results_list if d['trait'] == trait and d['cell_type'] == cell)\\n\",\n",

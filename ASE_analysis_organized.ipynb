    "    \"                results[\\\"ase_disease_associated_genes_count\\\"].append(cont_table.loc['ASE', 'Disease Associated Genes'])\\n\",\n",
    "    \"                results[\\\"nonase_disease_associated_genes_count\\\"].append(cont_table.loc['nonASE', 'Disease Associated Genes'])\\n\",\n",
    "    \"                results[\\\"ase_other_genes_count\\\"].append(cont_table.loc['ASE', 'Other Genes'])\\n\",\n",
    "    \"                results[\\\"nonase_other_genes_count\\\"].append(cont_table.loc['nonASE', 'Other Genes'])\\n\",\n",
    "    \"\\n\",\n",
    "    \"                fisher_test = run_fisher_exact_test_no_else(cont_table)\\n\",\n",

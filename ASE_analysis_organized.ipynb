    "    \"# # convert to one big plot for better presentation\\n\",\n",
    "    \"# plot_combined_stacked_barplot(\\n\",\n",
    "    \"#     df=results_df,\\n\",\n",
    "    \"#     disease_ase_col=\\\"ase_disease_associated_genes_count\\\",\\n\",\n",
    "    \"#     disease_nonase_col=\\\"nonase_disease_associated_genes_count\\\",\\n\",\n",
    "    \"#     other_ase_col=\\\"ase_other_genes_count\\\",\\n\",\n",
    "    \"#     other_nonase_col=\\\"nonase_other_genes_count\\\",\\n\",\n",
    "    \"#     p_value_col=\\\"adjusted_p_ASE_nonASE\\\",\\n\",\n",
    "    \"#     title=\\\"ASE vs. nonASE Frequencies by Gene Group, Trait, and Cell Type\\\"\\n\",\n",
    "    \"# )\\n\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"1c675503-d05f-4909-bf8f-980d74a3f5d9\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Checking if inside the ASE genes there is an enrichment for upregulated or downregulated genes\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"dbdb99bf-faf5-4900-9934-f90021a5e8c2\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-07-03T07:34:42.980665Z\",\n",
    "     \"start_time\": \"2025-07-03T07:34:42.963427Z\"\n",
    "    }\n",
    "   },\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# define better functions for this purpose\\n\",\n",
    "    \"\\n\",\n",
    "    \"def regulation_contingency_table(df, celltype, gene_list, threshold = 0):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Generates a contingency table comparing gene regulation (ASE/nonASE) and\\n\",\n",
    "    \"    up/down-regulation in humans vs. chimps, for genes in a specified list\\n\",\n",
    "    \"    versus genes not in the list. Excludes 'else' ASE type.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Args:\\n\",\n",
    "    \"        df (pd.DataFrame): The input DataFrame containing gene names, ASE types,\\n\",\n",
    "    \"                           and expression values for human and chimp.\\n\",\n",
    "    \"        celltype (str): The cell type string used to construct the ASE column name\\n\",\n",
    "    \"                        (e.g., \\\"Neurons\\\" -> \\\"Neurons_gene_ase_type\\\").\\n\",\n",
    "    \"        gene_list (list): A list of gene names (strings) to be considered \\\"in gene list\\\".\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"        pd.DataFrame: A contingency table with 4 columns:\\n\",\n",
    "    \"                      \\\"ASE Upregulated\\\", \\\"ASE Downregulated\\\",\\n\",\n",
    "    \"                      \\\"nonASE Upregulated\\\", \\\"nonASE Downregulated\\\"\\n\",\n",
    "    \"                      and two rows: \\\"In Gene List\\\" and \\\"Not in Gene List\\\".\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    ase_colname = celltype + \\\"_gene_ase_type\\\"\\n\",\n",
    "    \"    human_expr_col = celltype + \\\"_LFC_human_ref\\\"\\n\",\n",
    "    \"    gene_col_name = df.columns[0]  # Assuming gene names are in the first column\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Convert gene list and DataFrame gene names to lowercase\\n\",\n",
    "    \"    lowercase_gene_list = [gene.lower() for gene in gene_list]\\n\",\n",
    "    \"    df[gene_col_name] = df[gene_col_name].str.lower()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # determine regulation status\\n\",\n",
    "    \"    df['regulation_status'] = 'unchanged' # Default or for no significant diff\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    df.loc[df[human_expr_col] > 0 + threshold, 'regulation_status'] = 'Upregulated'\\n\",\n",
    "    \"    df.loc[df[human_expr_col] < 0 - threshold, 'regulation_status'] = 'Downregulated'\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Combine ASE type and regulation status\\n\",\n",
    "    \"    df['combined_category'] = df[ase_colname] + ' ' + df['regulation_status']\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Split DataFrame based on gene_list presence\\n\",\n",
    "    \"    genes_in_list_df = df[df[gene_col_name].isin(lowercase_gene_list)]['combined_category'].value_counts()\\n\",\n",
    "    \"    genes_not_in_list_df = df[~df[gene_col_name].isin(lowercase_gene_list)]['combined_category'].value_counts()\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Ensure all categories are present for both groups\\n\",\n",
    "    \"    all_categories = [\\\"ASE Upregulated\\\", \\\"ASE Downregulated\\\"]\\n\",\n",
    "    \"    genes_in_list_counts = genes_in_list_df.reindex(all_categories, fill_value=0)\\n\",\n",
    "    \"    genes_not_in_list_counts = genes_not_in_list_df.reindex(all_categories, fill_value=0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    \\n\",\n",
    "    \"\\n\",\n",
    "    \"    contingency_table = pd.DataFrame({\\n\",\n",
    "    \"        \\\"Disease Associated Genes\\\": genes_in_list_counts,\\n\",\n",
    "    \"        \\\"Other Genes\\\": genes_not_in_list_counts\\n\",\n",
    "    \"    })\\n\",\n",
    "    \"\\n\",\n",
    "    \"    n_associated = sum(genes_in_list_counts)\\n\",\n",
    "    \"    n_other = sum(genes_not_in_list_counts)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    contingency_table = contingency_table.T\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return contingency_table, n_associated, n_other\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def run_fisher_exact_test_new_table(contingency_table):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Performs a single Fisher's exact test comparing ASE Upregulated vs. ASE Downregulated\\n\",\n",
    "    \"    for genes in vs. not in the gene list.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Args:\\n\",\n",
    "    \"        contingency_table (pd.DataFrame): A DataFrame with 'In Gene List' and\\n\",\n",
    "    \"                                          'Not in Gene List' as rows, and\\n\",\n",
    "    \"                                          'ASE Upregulated', 'ASE Downregulated'\\n\",\n",
    "    \"                                          as columns.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"        dict: A dictionary containing \\\"oddsratio\\\" and \\\"pvalue\\\" for the\\n\",\n",
    "    \"              \\\"ASE Upregulated vs ASE Downregulated\\\" comparison.\\n\",\n",
    "    \"              Returns None if the contingency table is not in the expected format.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    # Define the expected column names (only ASE categories)\\n\",\n",
    "    \"    expected_columns = [\\n\",\n",
    "    \"        \\\"ASE Upregulated\\\",\\n\",\n",
    "    \"        \\\"ASE Downregulated\\\"\\n\",\n",
    "    \"    ]\\n\",\n",
    "    \"    # Define the expected index (row) names\\n\",\n",
    "    \"    expected_index = [\\\"Disease Associated Genes\\\", \\\"Other Genes\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Input validation for the contingency table's structure\\n\",\n",
    "    \"    # Expected shape is now (2, 2)\\n\",\n",
    "    \"    if contingency_table.shape != (2, 2) or \\\\\\n\",\n",
    "    \"       list(contingency_table.index) != expected_index or \\\\\\n\",\n",
    "    \"       list(contingency_table.columns) != expected_columns:\\n\",\n",
    "    \"        print(\\\"Warning: Contingency table is not in the expected 2x2 format with correct row and column names.\\\")\\n\",\n",
    "    \"        print(f\\\"Expected shape: (2, 2), Got: {contingency_table.shape}\\\")\\n\",\n",
    "    \"        print(f\\\"Expected index: {expected_index}, Got: {list(contingency_table.index)}\\\")\\n\",\n",
    "    \"        print(f\\\"Expected columns: {expected_columns}, Got: {list(contingency_table.columns)}\\\")\\n\",\n",
    "    \"        return None\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Construct the 2x2 table for the single Fisher's exact test:\\n\",\n",
    "    \"    #\\n\",\n",
    "    \"    #                  ASE Upregulated | ASE Downregulated\\n\",\n",
    "    \"    # ----------------------------------------------------\\n\",\n",
    "    \"    # In Gene List     Count_A         | Count_C\\n\",\n",
    "    \"    # Not in Gene List Count_B         | Count_D\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Count_A: \\\"ASE Upregulated\\\" for \\\"In Gene List\\\"\\n\",\n",
    "    \"    Count_A = contingency_table.loc[\\\"Disease Associated Genes\\\", \\\"ASE Upregulated\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Count_C: \\\"ASE Downregulated\\\" for \\\"In Gene List\\\"\\n\",\n",
    "    \"    Count_C = contingency_table.loc[\\\"Disease Associated Genes\\\", \\\"ASE Downregulated\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Count_B: \\\"ASE Upregulated\\\" for \\\"Not in Gene List\\\"\\n\",\n",
    "    \"    Count_B = contingency_table.loc[\\\"Other Genes\\\", \\\"ASE Upregulated\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Count_D: \\\"ASE Downregulated\\\" for \\\"Not in Gene List\\\"\\n\",\n",
    "    \"    Count_D = contingency_table.loc[\\\"Other Genes\\\", \\\"ASE Downregulated\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Construct the 2x2 table for Fisher's exact test\\n\",\n",
    "    \"    table = [[Count_A, Count_C],\\n\",\n",
    "    \"             [Count_B, Count_D]]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Ensure table elements are integers (important for fisher_exact)\\n\",\n",
    "    \"    table = [[int(val) for val in row] for row in table]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Check for zero rows/columns which can cause issues or meaningless results\\n\",\n",
    "    \"    if sum(table[0]) == 0 or sum(table[1]) == 0 or sum(row[0] for row in table) == 0 or sum(row[1] for row in table) == 0:\\n\",\n",
    "    \"        print(f\\\"Warning: Skipping Fisher's exact test due to all zeros in a row or column in the 2x2 table: {table}\\\")\\n\",\n",
    "    \"        return None, None\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        oddsratio, pvalue = fisher_exact(table, alternative='two-sided')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return oddsratio, pvalue\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"def plot_ase_distribution_frequencies_regulation(contingency_table, title=\\\"ASE Frequency Distribution\\\", result = None):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Generates a stacked bar plot showing the frequency distribution of\\n\",\n",
    "    \"    up/down-regulation for genes in and not in the gene list.\\n\",\n",
    "    \"    Prints total number of genes above each bar.\\n\",\n",
    "    \"\\n\",\n",
    "    \"    Args:\\n\",\n",
    "    \"        contingency_table (pd.DataFrame): A DataFrame with 'Disease Associated Genes' and\\n\",\n",
    "    \"                                          'Other Genes' as rows, and\\n\",\n",
    "    \"                                          'ASE Upregulated', 'ASE Downregulated' as columns.\\n\",\n",
    "    \"        title (str, optional): The title of the plot. Defaults to \\\"ASE Frequency Distribution\\\".\\n\",\n",
    "    \"        result (tuple): A tuple containing the odds ratio and the *FDR-adjusted p-value*.\\n\",\n",
    "    \"                        Ensure the p-value passed here is *already* FDR-adjusted.\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    # Define the expected column names\\n\",\n",
    "    \"    expected_columns = [\\n\",\n",
    "    \"        \\\"ASE Upregulated\\\",\\n\",\n",
    "    \"        \\\"ASE Downregulated\\\",\\n\",\n",
    "    \"    ]\\n\",\n",
    "    \"    # Define the expected index (row) names\\n\",\n",
    "    \"    expected_index = [\\\"Disease Associated Genes\\\", \\\"Other Genes\\\"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Basic validation for the contingency table structure\\n\",\n",
    "    \"    if contingency_table.shape != (2, len(expected_columns)) or \\\\\\n\",\n",
    "    \"       list(contingency_table.index) != expected_index or \\\\\\n\",\n",
    "    \"       list(contingency_table.columns) != expected_columns:\\n\",\n",
    "    \"        print(f\\\"Warning: Regulation contingency table for '{title}' is not in the expected format.\\\")\\n\",\n",
    "    \"        print(f\\\"Expected index: {expected_index}, Got: {list(contingency_table.index)}\\\")\\n\",\n",
    "    \"        print(f\\\"Expected columns: {expected_columns}, Got: {list(contingency_table.columns)}\\\")\\n\",\n",
    "    \"        return\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Calculate the total number of genes for each main group (Disease Associated Genes, Other Genes)\\n\",\n",
    "    \"    total_in_list = contingency_table.loc[\\\"Disease Associated Genes\\\"].sum()\\n\",\n",
    "    \"    total_not_in_list = contingency_table.loc[\\\"Other Genes\\\"].sum()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Create a frequencies table by dividing each row by its total\\n\",\n",
    "    \"    freq_table = contingency_table.copy()\\n\",\n",
    "    \"    freq_table.loc[\\\"Disease Associated Genes\\\"] = (freq_table.loc[\\\"Disease Associated Genes\\\"] / total_in_list) if total_in_list > 0 else 0.0\\n\",\n",
    "    \"    freq_table.loc[\\\"Other Genes\\\"] = (freq_table.loc[\\\"Other Genes\\\"] / total_not_in_list) if total_not_in_list > 0 else 0.0\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Define the custom colors based on the *actual column names*\\n\",\n",
    "    \"    # The plotting function will use these column names directly for stacking\\n\",\n",
    "    \"    plot_colors = {\\n\",\n",
    "    \"        \\\"ASE Upregulated\\\": \\\"green\\\",\\n\",\n",
    "    \"        \\\"ASE Downregulated\\\": \\\"red\\\",\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Define the desired legend labels (these will be used explicitly in plt.legend)\\n\",\n",
    "    \"    legend_labels = {\\n\",\n",
    "    \"        \\\"ASE Upregulated\\\": \\\"Upregulated\\\",\\n\",\n",
    "    \"        \\\"ASE Downregulated\\\": \\\"Downregulated\\\",\\n\",\n",
    "    \"    }\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Plotting\\n\",\n",
    "    \"    fig, ax = plt.subplots(figsize=(10, 7)) # Increased figsize for better readability\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Plotting the freq_table directly, mapping column names to colors\\n\",\n",
    "    \"    # Ensure the order of colors matches the order of columns in freq_table for plotting\\n\",\n",
    "    \"    colors_to_use = [plot_colors[col] for col in freq_table.columns]\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    freq_table.plot(kind='bar', stacked=True, ax=ax, color=colors_to_use)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    plt.title(title)\\n\",\n",
    "    \"    plt.ylabel(\\\"Frequency\\\")\\n\",\n",
    "    \"    plt.xlabel(\\\"Gene Group\\\")\\n\",\n",
    "    \"    plt.xticks(rotation=0) # Keep labels horizontal\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Adjust legend position to avoid overlapping with plot\\n\",\n",
    "    \"    # Explicitly set labels for the legend using the desired names\\n\",\n",
    "    \"    handles, current_labels = ax.get_legend_handles_labels()\\n\",\n",
    "    \"    # Map current_labels (which are freq_table.columns) to desired legend_labels\\n\",\n",
    "    \"    new_labels = [legend_labels[label] for label in current_labels]\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.legend(handles, new_labels, title=\\\"Regulation Type\\\", bbox_to_anchor=(1.05, 1), loc='upper left')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # P-VALUE DISPLAY LOGIC\\n\",\n",
    "    \"    if result and len(result) > 1:\\n\",\n",
    "    \"        p_val_display = result[1]\\n\",\n",
    "    \"        if p_val_display < 0.001:\\n\",\n",
    "    \"            p_value_text = \\\"FDR p-value < 0.001\\\"\\n\",\n",
    "    \"        else:\\n\",\n",
    "    \"            p_value_text = f\\\"FDR p-value = {p_val_display:.3f}\\\"\\n\",\n",
    "    \"\\n\",\n",
    "    \"        plt.text(\\n\",\n",
    "    \"            0.5, 0.02,\\n\",\n",
    "    \"            p_value_text,\\n\",\n",
    "    \"            fontsize=11,\\n\",\n",
    "    \"            ha='center',\\n\",\n",
    "    \"            va='bottom',\\n\",\n",
    "    \"            transform=plt.gca().transAxes\\n\",\n",
    "    \"        )\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Add total counts above each bar\\n\",\n",
    "    \"    totals = [total_in_list, total_not_in_list]\\n\",\n",
    "    \"    for i, total in enumerate(totals):\\n\",\n",
    "    \"        ax.text(i, 1.02, f'n={int(total)}', ha='center', va='bottom', fontsize=10, color='black', weight='bold')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    target_dir = 'barplots_ASE_with_regulation_direction'\\n\",\n",
    "    \"    os.makedirs(target_dir, exist_ok=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    sanitized_title = title.replace(' ', '_').replace('/', '_').replace('\\\\\\\\', '_').replace(':', '_').replace('\\\\n', '_').replace('.', '')\\n\",\n",
    "    \"    plt.savefig(f\\\"{target_dir}/{sanitized_title}.png\\\")\\n\",\n",
    "    \"    plt.show() # Keep plt.show() for direct display if running as script\\n\",\n",
    "    \"    plt.close() # Close the plot to free memory if generating many plots\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"fe5ac241-3963-4655-bde7-360d66f4ed79\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-07-03T07:34:46.030571Z\",\n",
    "     \"start_time\": \"2025-07-03T07:34:43.046611Z\"\n",
    "    },\n",
    "    \"scrolled\": true\n",
    "   },\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import warnings\\n\",\n",
    "    \"warnings.filterwarnings(\\\"ignore\\\")\\n\",\n",
    "    \"# run new test:\\n\",\n",
    "    \"new_test_results = {\\\"trait\\\": [], \\\"cell_type\\\": [], \\\"odds_ratio_regulation\\\": [], \\\"p_value_regulation\\\": [],\\n\",\n",
    "    \"                    \\\"upregulated_disease_associated_genes_count\\\": [], \\\"downregulated_disease_associated_genes_count\\\": [],\\n\",\n",
    "    \"                    \\\"upregulated_other_genes_count\\\": [], \\\"downregulated_other_genes_count\\\": []}\\n\",\n",
    "    \"\\n\",\n",
    "    \"for index, row in disease_info_df.iterrows():\\n\",\n",
    "    \"    disease = row[\\\"Disease_name\\\"]\\n\",\n",
    "    \"    disease_celltypes = row[\\\"Celltypes\\\"]\\n\",\n",
    "    \"    genes = row[\\\"gene_list\\\"]\\n\",\n",
    "    \"    for celltype in disease_celltypes:\\n\",\n",
    "    \"        cont_table, n_associated, n_other = regulation_contingency_table(filtered_data_by_gene_list, celltype, genes)\\n\",\n",
    "    \"        # Check that none of the columns are empty\\n\",\n",
    "    \"        if (cont_table.loc['Disease Associated Genes'].sum() >= min_genes) and (cont_table.loc['Other Genes'].sum() >= min_genes):\\n\",\n",
    "    \"            fisher_test = run_fisher_exact_test_new_table(cont_table)\\n\",\n",
    "    \"            new_test_results[\\\"trait\\\"].append(disease)\\n\",\n",
    "    \"            new_test_results[\\\"cell_type\\\"].append(celltype)\\n\",\n",
    "    \"            new_test_results[\\\"upregulated_disease_associated_genes_count\\\"].append(cont_table.loc['Disease Associated Genes', 'ASE Upregulated'])\\n\",\n",
    "    \"            new_test_results[\\\"downregulated_disease_associated_genes_count\\\"].append(cont_table.loc['Disease Associated Genes', 'ASE Downregulated'])\\n\",\n",
    "    \"            new_test_results[\\\"upregulated_other_genes_count\\\"].append(cont_table.loc['Other Genes', 'ASE Upregulated'])\\n\",\n",
    "    \"            new_test_results[\\\"downregulated_other_genes_count\\\"].append(cont_table.loc['Other Genes', 'ASE Downregulated'])\\n\",\n",
    "    \"            new_test_results[\\\"odds_ratio_regulation\\\"].append(fisher_test[0])\\n\",\n",
    "    \"            new_test_results[\\\"p_value_regulation\\\"].append(fisher_test[1])\\n\",\n",
    "    \"            # plot_ase_distribution_frequencies_regulation(cont_table, title=f\\\"ASE distribution of {celltype} in context of {disease}\\\", result = fisher_test)\\n\",\n",
    "    \"\\n\",\n",
    "    \"new_test_df = pd.DataFrame.from_dict(new_test_results)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"id\": \"e25b4667-4681-4071-a98d-2000d6bba4fe\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-07-03T07:34:46.073027Z\",\n",

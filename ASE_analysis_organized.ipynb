    "    \"\\n\",\n",
    "    \"    # correct p values using fdr\\n\",\n",
    "    \"    pvals = [current_trait_celltype_data[f\\\"raw_p_value_bin_{i}\\\"] for i in range(10)]\\n\",\n",
    "    \"    valid_pvals = []\\n\",\n",

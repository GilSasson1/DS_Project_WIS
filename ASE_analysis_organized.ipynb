    "    \"    for celltype in disease_celltypes:\\n\",\n",
    "    \"        cont_table = contingency_table(data, celltype, genes)\\n\",\n",
    "    \"        plot_ase_distribution_frequencies(cont_table, title=f\\\"ASE distribution of {celltype} in context of {disease}\\\")\\n\",\n",
    "    \"        # print(run_fisher_exact_test(cont_table))\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"83aa78e7-e5ea-47db-8670-b65449bca529\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"#### The main output from this part is that data is too enriched with \\\"else\\\" genes. This happens because lots of genes are not mapped to the chimp genome, and also because for some genes the ASE analysis yields different answers when aligning to the human ref or to the chimp ref. Therefore, we will exclude any \\\"else\\\" gene from further parts of the analysis.\\n\",\n",
    "    \"\\n\",\n",
    "    \"#### In addition, we are trying to create a background that is as similar to ours as possible. therefore, we only include in our analysis genes that appear at least in one GWAS or ClinVar report, because this means they have some clinical relevance and are possibly more studied. \"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"id\": \"529291b7-1de2-4c30-9974-5048acd5b97e\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### repeat ASE analysis (barplots) but with filtered gene rows in ASE data: get rid of genes that are marked as \\\"else\\\" in all relevant celltypes, and genes that do not exist in the \\\"GWAS\\\" and \\\"ClinVar\\\" catalogs as related to any of the traits.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": 11,\n",
    "   \"id\": \"0d72ee60-3946-4991-b8ec-ec4ca3ae4f2f\",\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2025-07-03T07:34:28.833273Z\",\n",
    "     \"start_time\": \"2025-07-03T07:34:28.750992Z\"\n",
    "    }\n",
    "   },\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Original Data:\\n\",\n",
    "      \"(46123, 349)\\n\",\n",
    "      \"\\n\",\n",
    "      \"Filtered Data (rows where at least one ASE column is not 'else'):\\n\",\n",
    "      \"(18701, 349)\\n\",\n",
    "      \"rows that were deleted:\\n\",\n",
    "      \"27422\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"source\": [\n",
    "    \"# filter out genes that are matked as \\\"else\\\" in all relevant celltypes\\n\",\n",
    "    \"\\n\",\n",
    "    \"rows_to_keep = pd.Series(False, index=data.index)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Iterate through each column in ASE_type_columns\\n\",\n",
    "    \"for col in ASE_type_columns:\\n\",\n",
    "    \"    if col in data.columns: # Good practice to check if the column actually exists\\n\",\n",
    "    \"        # Create a boolean Series for rows where the current column is NOT 'else'\\n\",\n",
    "    \"        is_not_else = data[col] != \\\"else\\\"\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        # Use the OR operator (|) to update 'rows_to_keep'\\n\",\n",
    "    \"        # If a row was already True (because a previous column was not 'else'), it stays True.\\n\",\n",
    "    \"        # If it's False, it becomes True if 'is_not_else' is True for the current column.\\n\",\n",
    "    \"        rows_to_keep = rows_to_keep | is_not_else\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        print(f\\\"Warning: Column '{col}' not found in the DataFrame. Skipping this column for filtering.\\\")\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Create the new DataFrame 'filtered_data' using the boolean Series\\n\",\n",
    "    \"filtered_data = data[rows_to_keep].copy() # .copy() to avoid SettingWithCopyWarning later\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(\\\"Original Data:\\\")\\n\",\n",
    "    \"print(data.shape)\\n\",\n",
    "    \"print(\\\"\\\\nFiltered Data (rows where at least one ASE column is not 'else'):\\\")\\n\",\n",
    "    \"print(filtered_data.shape)\\n\",\n",
    "    \"print(\\\"rows that were deleted:\\\")\\n\",\n",
    "    \"print(data.shape[0] - filtered_data.shape[0])\"\n",
    "   ]\n",
    "  },\n",

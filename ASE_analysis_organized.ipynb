    "   \"source\": [\n",
    "    \"# # convert to one big plot for better presentation\\n\",\n",
    "    \"# plot_combined_stacked_barplot(\\n\",\n",
    "    \"#     df=new_test_df,\\n\",\n",
    "    \"#     disease_ase_col=\\\"upregulated_disease_associated_genes_count\\\",\\n\",\n",
    "    \"#     disease_nonase_col=\\\"downregulated_disease_associated_genes_count\\\",\\n\",\n",
    "    \"#     other_ase_col=\\\"upregulated_other_genes_count\\\",\\n\",\n",
    "    \"#     other_nonase_col=\\\"downregulated_other_genes_count\\\",\\n\",\n",
    "    \"#     p_value_col=\\\"adjusted_p_regulation\\\",\\n\",\n",
    "    \"#     ase_color='green',\\n\",\n",
    "    \"#     nonase_color='red',\\n\",\n",
    "    \"#     title=\\\"Upregulated vs. Downregulated ASE Gene Frequencies by Gene Group, Trait, and Cell Type\\\"\\n\",\n",

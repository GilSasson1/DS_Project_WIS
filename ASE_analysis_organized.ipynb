    "    \"valid_col_js = []\\n\",\n",
    "    \"for j, col in enumerate(bins_results_df.columns.tolist()):\\n\",\n",
    "    \"    if col in [f\\\"raw_p_value_bin_{i}\\\" for i in range(10)]:\\n\",\n",

    "   \"source\": [\n",
    "    \"# get coreelation for LFC bins: absolute values\\n\",\n",
    "    \"\\n\",\n",
    "    \"from scipy.stats import spearmanr\\n\",\n",
    "    \"\\n\",\n",
    "    \"results_list = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"row = disease_info_df.iloc[17]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# for index, row in disease_info_df.iterrows():\\n\",\n",

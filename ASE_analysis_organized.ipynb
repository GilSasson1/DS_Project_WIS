    "    \"            # all_spearman_pvalues_for_fdr.append(spearman_p) # Collect for global FDR\\n\",\n",
    "    \"        except ValueError as e:\\n\",\n",
    "    \"            # This can happen if all odds ratios are the same, spearmanr can't compute\\n\",\n",
    "    \"            print(f\\\"Warning: Spearman correlation failed for {disease}-{celltype}. Reason: {e}\\\")\\n\",\n",
    "    \"            current_trait_celltype_data['spearman_r'] = None\\n\",\n",
    "    \"            current_trait_celltype_data['spearman_p_value'] = None\\n\",\n",
    "    \"    else:\\n\",\n",

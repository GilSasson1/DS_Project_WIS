    "    \"        fill=True,           # Fills the area under the density curves\\n\",\n",
    "    \"        common_norm=False,   # Normalizes each 'direction' distribution separately\\n\",\n",
    "    \"        palette=single_direction_color,\\n\",\n",
    "    \"        alpha=0.6,\\n\",\n",
    "    \"        linewidth=2,\\n\",\n",
    "    \"        cut=0                # Ensures the density does not go beyond the data limits\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    plt.title('Distribution of size of regulation changes between human and chimp, by direction of regulation change', fontsize=16)\\n\",\n",
    "    \"    plt.xlabel(f'Absolute Log Fold Change (scoliosis genes in {ct})', fontsize=12) # Changed to Absolute LFC\\n\",\n",
    "    \"    plt.ylabel('Density', fontsize=12)\\n\",\n",
    "    \"    # plt.xlim(0)\\n\",\n",
    "    \"    plt.grid(True, linestyle='--', alpha=0.7)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Add p-value to the plot\\n\",\n",
    "    \"    if p_value_text != \\\"Insufficient data for test\\\":\\n\",\n",
    "    \"        plt.text(0.95, 0.95, p_value_text, transform=ax.transAxes,\\n\",\n",
    "    \"                 fontsize=12, verticalalignment='top', horizontalalignment='right',\\n\",\n",
    "    \"                 bbox=dict(boxstyle='round,pad=0.5', fc='white', alpha=0.7))\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        plt.text(0.95, 0.95, p_value_text, transform=ax.transAxes,\\n\",\n",
    "    \"                 fontsize=12, verticalalignment='top', horizontalalignment='right',\\n\",\n",
    "    \"                 bbox=dict(boxstyle='round,pad=0.5', fc='white', alpha=0.7))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Add gene counts to the plot, slightly below the p-value\\n\",\n",
    "    \"    gene_counts_text = f'N_up = {n_upregulated}\\\\nN_down = {n_downregulated}'\\n\",\n",
    "    \"    plt.text(0.95, 0.85, gene_counts_text, transform=ax.transAxes, # Adjusted y-coordinate\\n\",\n",
    "    \"             fontsize=12, verticalalignment='top', horizontalalignment='right',\\n\",\n",
    "    \"             bbox=dict(boxstyle='round,pad=0.5', fc='white', alpha=0.7))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    plt.tight_layout()\\n\",\n",
    "    \"    # Ensure the directory exists\\n\",\n",
    "    \"    import os\\n\",\n",
    "    \"    if not os.path.exists(\\\"scoliosis_correlations\\\"):\\n\",\n",
    "    \"        os.makedirs(\\\"scoliosis_correlations\\\")\\n\",\n",
    "    \"    plt.savefig(f\\\"scoliosis_correlations/{ct}_histograms_up_down.png\\\")\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"print(\\\"Plots generated and saved in 'scoliosis_correlations' directory with p-values.\\\")\\n\",\n",
    "    \"    \\n\"\n",
    "   ]\n",
